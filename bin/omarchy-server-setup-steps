#!/bin/bash

# omarchy:summary=Print the Omarchy Server setup steps still to do, one per line
# omarchy:hidden=true

# storage is done once a network mount is configured in /etc/fstab or as a
# mount unit, or the owner marked it with omarchy-done mark server-storage.
# backups is done once the backup setup marks server-backups. agent is done
# once a default coding agent is chosen and installed.

network_mounts() {
  awk '$1 !~ /^#/ && $3 ~ /^(nfs|nfs4|cifs|smb3|fuse\.sshfs|sshfs)$/ { found = 1 } END { exit !found }' /etc/fstab 2>/dev/null ||
    compgen -G "/etc/systemd/system/*.mount" >/dev/null
}

network_mounts || omarchy-done check server-storage || echo storage
omarchy-done check server-backups || echo backups

agent=$(omarchy-default-agent)
[[ -n $agent ]] && omarchy-cmd-present "$agent" || echo agent
