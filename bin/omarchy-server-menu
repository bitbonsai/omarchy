#!/bin/bash

# omarchy:summary=Open the Omarchy Server menu, a type-to-filter list in the terminal
# omarchy:hidden=true

# omarchy menu runs this on Omarchy Server. A row opens a list of its own or
# runs a tool in this terminal, and Esc goes back. Icons show only in terminals
# known to draw Nerd Font symbols: Ghostty and kitty carry them, and Omarchy
# sets up foot and Alacritty with a Nerd Font.

set -uo pipefail

case ${TERM:-} in
  xterm-ghostty | xterm-kitty | alacritty | foot* | tmux*) icons=1 ;;
  *) icons=0 ;;
esac
[[ ${OMARCHY_ASCII:-0} == 1 ]] && icons=0

dim=$'\e[2m' green=$'\e[32m' red=$'\e[31m' amber=$'\e[33m' reset=$'\e[0m'
muted=$'\e[38;2;139;143;158m' sep_fg=$'\e[38;2;86;95;137m'

in_popup() {
  [[ -n ${OMARCHY_IN_POPUP:-} && -n ${TMUX:-} ]]
}

# Rounded Nerd Font pills matching the tmux bottom status bar (on #16161e popup bg).
pill() {
  local pbg=$1 pfg=$2 text=$3 outer="48;2;22;22;30;"
  in_popup || outer=""
  if (( icons )); then
    printf '\e[%s38;2;%sm\e[48;2;%s;38;2;%sm%s\e[0m\e[%s38;2;%sm\e[0m' \
      "$outer" "$pbg" "$pbg" "$pfg" "$text" "$outer" "$pbg"
  else
    printf '\e[48;2;%s;38;2;%sm %s \e[0m' "$pbg" "$pfg" "$text"
  fi
}

pill_amber() { pill "42;36;21" "224;175;104;1" "$1"; }
pill_slate() { pill "36;40;59" "192;202;245" "$1"; }
pill_key()   { pill "36;40;59" "224;175;104" "$1"; }
pill_green() { pill "28;43;34" "158;206;106" "$1"; }
pill_red()   { pill "59;29;40" "247;118;142;1" "$1"; }
pill_muted() { pill "28;31;46" "139;143;158" "$1"; }

crumb() {
  local root_label="om"
  (( icons )) && root_label="󰀻 om"
  if (($# == 0)); then
    pill_amber "$root_label"
    return
  fi
  local out
  out=$(pill_amber "$root_label")
  local part
  for part in "$@"; do
    out+=" ${sep_fg}›${reset} $(pill_slate "$part")"
  done
  printf '%s' "$out"
}

crumb_header() {
  printf '%s\n ' "$(crumb "$@")"
}

open_tab() {
  local name=$1 cmd=$2
  tmux new-window -n "$name" "$cmd"
  exit 0
}

preview_pane() {
  local key=${1:-}
  case $key in
    setup)
      printf '%s\n\n' "$(pill_amber "Finish setup")"
      omarchy-server-setup-steps | while read -r s; do
        printf '  %s○%s %s\n' "$amber" "$reset" "$s"
      done
      ;;
    services)
      local count failed badge
      count=$(systemctl list-units --type=service --state=running --no-legend --plain 2>/dev/null | wc -l)
      failed=$(systemctl --failed --no-legend --plain 2>/dev/null | wc -l)
      if (( failed > 0 )); then
        badge="$(pill_red "$failed failed") $(pill_muted "$count running")"
      else
        badge="$(pill_muted "$count running · 0 failed")"
      fi
      printf '%s  %s\n\n' "$(pill_amber "Services")" "$badge"
      systemctl --failed --no-legend --plain 2>/dev/null | head -5 | while read -r u _; do
        printf '  %s●%s %s %sfailed%s\n' "$red" "$reset" "${u%.service}" "$red" "$reset"
      done
      systemctl --user list-units --type=service --state=running --no-legend --plain 2>/dev/null | head -6 | while read -r u _; do
        printf '  %s●%s %s %suser%s\n' "$green" "$reset" "${u%.service}" "$dim" "$reset"
      done
      systemctl list-units --type=service --state=running --no-legend --plain 2>/dev/null | grep -E '^(sshd|tailscaled|ufw|caddy|podman)' | head -6 | while read -r u _; do
        printf '  %s●%s %s %ssystem%s\n' "$green" "$reset" "${u%.service}" "$dim" "$reset"
      done
      ;;
    network)
      printf '%s\n\n' "$(pill_amber "Network")"
      ip -brief address 2>/dev/null | awk '$2 == "UP" || $1 ~ /^tailscale/ { printf "  %-12s %s\n", $1, $3 }'
      echo
      if command -v tailscale >/dev/null 2>&1 && timeout 1 tailscale status >/dev/null 2>&1; then
        printf '  %s\n' "$(pill_green "● Tailscale connected")"
      else
        printf '  %s\n' "$(pill_muted "○ Tailscale not connected")"
      fi
      ;;
    storage)
      printf '%s\n\n' "$(pill_amber "Storage & backups")"
      df -h / /home 2>/dev/null | awk 'NR==1 || !seen[$1]++ { printf "  %s\n", $0 }'
      echo
      local repo_file="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/backup-repo"
      if [[ -r $repo_file ]]; then
        printf '  %sLast repo:%s %s\n' "$dim" "$reset" "$(<"$repo_file")"
      else
        printf '  %sNo backup repository configured yet.%s\n' "$dim" "$reset"
      fi
      ;;
    agent)
      local agent
      agent=$(omarchy-default-agent 2>/dev/null || true)
      printf '%s\n\n' "$(pill_amber "Coding agent")"
      if [[ -n $agent ]]; then
        printf '  Default: %s\n\n  %sOpens in a dedicated tmux tab.%s\n' "$(pill_slate "$agent")" "$dim" "$reset"
      else
        printf '  %sNot configured yet. Press Enter to pick one.%s\n' "$dim" "$reset"
      fi
      ;;
    updates)
      printf '%s  %s\n\n' "$(pill_amber "System updates")" "$(pill_muted "$(omarchy-version 2>/dev/null || echo dev)")"
      printf '  %sEnter runs omarchy update in a tmux tab.%s\n' "$dim" "$reset"
      ;;
    fleet)
      printf '%s\n\n' "$(pill_amber "Tailscale fleet")"
      if omarchy-fleet list 2>/dev/null | head -8 | while IFS=$'\t' read -r h st ip; do
        if [[ $st == "online" ]]; then
          printf '  %s●%s %-14s %s%s%s\n' "$green" "$reset" "$h" "$dim" "$ip" "$reset"
        else
          printf '  %s○ %-14s offline%s\n' "$dim" "$h" "$reset"
        fi
      done; then
        :
      else
        printf '  %s\n' "$(pill_muted "Tailscale not connected")"
      fi
      ;;
  esac
}

if [[ ${1:-} == "--preview" ]]; then
  preview_pane "${2:-}"
  exit 0
fi

# A row is "<shown>\t<key>": the label, then its hint dimmed in a column.
row() {
  local icon=$1 label=$2 hint=$3 key=$4

  if (( icons )) && [[ -n $icon ]]; then
    label="$icon  $label"
  fi
  # printf pads by bytes, and icons are several, so pad by characters.
  printf '%s%*s%s\t%s\n' "$label" $(( 30 - ${#label} )) "" "${hint:+$dim$hint$reset}" "$key"
}

# Prints the chosen row's key, after the key pressed when --expect is passed.
# Fails on Esc. The first argument names what Enter does.
pick() {
  local enter=$1
  shift

  local ftr colors="pointer:#e0af68,fg+:#e0af68,bg+:#24283b,hl:#e0af68,hl+:#e0af68,border:#3b3526,separator:#24283b,prompt:#e0af68,ghost:#565f89"
  in_popup && colors="bg:#16161e,gutter:#16161e,preview-bg:#16161e,$colors"
  ftr="$(pill_key "type") ${muted}filter${reset}   $(pill_key "↵") ${muted}${enter}${reset}   $(pill_key "esc") ${muted}back${reset}"

  fzf --ansi --layout=reverse --height=100% --padding="1,2" --header-first --info=hidden --separator=" " \
    --delimiter=$'\t' --with-nth=1 --prompt="❯ " --ghost="Go…" --pointer="▌" --gutter=" " \
    --color="$colors" \
    --footer="$ftr" "$@" |
    cut -f2
}

pause() {
  echo
  read -rsn1 -p "  Press any key to go back"
  echo
}

run_padded() {
  local header=""
  if [[ ${1:-} == "--header" ]]; then
    header=$2
    shift 2
  fi
  if ! in_popup || ! command -v python3 >/dev/null 2>&1; then
    "$@"
    return
  fi

  clear
  [[ -n $header ]] && printf '\n  %s\n' "$header"
  python3 -c '
import fcntl, os, pty, re, select, struct, sys, termios, tty

if not sys.stdin.isatty() or not sys.stdout.isatty():
    os.execvp(sys.argv[1], sys.argv[1:])

ws = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\x00" * 8)
rows, cols, _, _ = struct.unpack("HHHH", ws)
pid, fd = pty.fork()
if pid == 0:
    os.execvp(sys.argv[1], sys.argv[1:])

fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", max(5, rows - 2), max(20, cols - 4), 0, 0))
old = termios.tcgetattr(sys.stdin.fileno())
tty.setraw(sys.stdin.fileno())
os.write(sys.stdout.fileno(), b"\r\n  ")
try:
    while True:
        r, _, _ = select.select([fd, sys.stdin.fileno()], [], [])
        if fd in r:
            try:
                data = os.read(fd, 4096)
            except OSError:
                break
            if not data:
                break
            out = re.sub(rb"\r\n|\r|\n", lambda m: m.group(0) + b"  ", data)
            os.write(sys.stdout.fileno(), out)
        if sys.stdin.fileno() in r:
            data = os.read(sys.stdin.fileno(), 1024)
            if not data:
                break
            os.write(fd, data)
finally:
    termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
    os.write(sys.stdout.fileno(), b"\r")
    os.close(fd)

_, status = os.waitpid(pid, 0)
sys.exit(os.waitstatus_to_exitcode(status))
' "$@"
}

page() {
  local title=$1
  shift
  local out lines rows pad rc=0 less_args=(-R)
  out=$("$@" 2>&1)
  rows=$(tput lines 2>/dev/null || echo 24)
  lines=$(printf '%s\n' "$out" | wc -l)
  if in_popup; then
    less_args+=(--lesskey-content=$'#command\nt quit T\n' -P ' q back  ·  t open in tab')
  else
    less_args+=(-P ' q back')
  fi
  {
    printf '\n  %s\n\n' "$(crumb "$title")"
    printf '%s\n' "$out" | sed 's/^/  /'
    if (( lines + 4 < rows )); then
      for (( pad = lines + 4; pad < rows; pad++ )); do
        printf '\n'
      done
    fi
  } | LESSUTFCHARDEF="E000-F8FF:p,F0000-FFFFD:p" less "${less_args[@]}" || rc=$?

  if (( rc == 84 )) && in_popup; then
    local tmp
    tmp=$(mktemp /tmp/omarchy-page.XXXXXX)
    printf '%s\n' "$out" >"$tmp"
    open_tab "$title" "less -R -~ -P ' q close' $(printf '%q' "$tmp"); rm -f $(printf '%q' "$tmp")"
  fi
}

main_rows() {
  local steps updates=${1:-} down

  steps=$(omarchy-server-setup-steps | wc -l)
  if (( steps == 1 )); then
    row "" "Finish setup" "1 step left" setup
  elif (( steps > 1 )); then
    row "" "Finish setup" "$steps steps left" setup
  fi

  down=$(omarchy-server-update-watch down | wc -l)
  if (( down )); then
    row "" "Services" "$down down" services
  else
    row "" "Services" "›" services
  fi
  row "" "Network" "›" network
  row "" "Storage and backups" "›" storage
  row "󰚩" "Agent" "" agent
  row "" "Updates" "$updates" updates
  row "" "Fleet" "" fleet
}

# checkupdates syncs a copy of the package databases, which takes a while, so
# the menu opens without the count and fills it in when it arrives.
if [[ ${1:-} == "--rows-with-updates" ]]; then
  count=$(timeout 30 checkupdates 2>/dev/null | wc -l)
  if (( count )); then
    main_rows "$count available"
  else
    main_rows
  fi
  exit 0
fi

setup_menu() {
  local step choice

  choice=$(
    while read -r step; do
      case $step in
        storage) row "" "Storage" "network mounts" storage ;;
        backups) row "" "Backups" "" backups ;;
        agent) row "" "Agent" "choose a coding agent" agent ;;
      esac
    done < <(omarchy-server-setup-steps) | pick open --header "$(crumb_header "Finish setup")"
  ) || return

  case $choice in
    storage | backups) storage_menu ;;
    agent) agent_menu ;;
  esac
}

services_menu() {
  local choice kind unit

  while :; do
    choice=$(
      {
        while read -r kind unit; do
          [[ $kind == "mount" ]] && continue
          row "" "${unit%.service}" "down since the update" "$kind:$unit"
        done < <(omarchy-server-update-watch down)
        systemctl --user list-units --type=service --state=running,failed --no-legend --plain |
          while read -r unit _ _ state _; do row "" "${unit%.service}" "$state, user" "user:$unit"; done
        systemctl list-units --type=service --state=running,failed --no-legend --plain |
          while read -r unit _ _ state _; do row "" "${unit%.service}" "$state" "system:$unit"; done
      } | pick open --header "$(crumb_header "Services")"
    ) || return

    unit_menu "${choice%%:*}" "${choice#*:}"
  done
}

unit_menu() {
  local scope=$1 unit=$2 choice
  local systemctl=(systemctl) restart=(sudo systemctl) journal=(journalctl)

  if [[ $scope == "user" ]]; then
    systemctl+=(--user)
    restart=(systemctl --user)
    journal+=(--user)
  fi

  choice=$({
    row "" "Status" "" status
    row "" "Logs" "" logs
    row "" "Restart" "" restart
  } | pick open --header "$(crumb_header "Services" "${unit%.service}")") || return

  case $choice in
    status) page "status:${unit%.service}" "${systemctl[@]}" status "$unit" ;;
    logs)
      if in_popup; then
        open_tab "logs:${unit%.service}" "${journal[*]} -u $(printf '%q' "$unit") -f"
      else
        "${journal[@]}" -u "$unit" -e
      fi
      ;;
    restart) run_padded "${restart[@]}" restart "$unit"; pause ;;
  esac
}

network_menu() {
  local choice

  while :; do
    choice=$({
      row "" "Addresses" "" addresses
      row "" "Connections" "nmtui" connections
      row "" "Firewall" "" firewall
      row "" "Cloudflare tunnel" "" tunnel
      if omarchy-cmd-present tailscale; then
        row "" "Tailscale" "" tailscale
      else
        row "" "Set up Tailscale" "" tailscale-install
      fi
    } | pick open --header "$(crumb_header "Network")") || return

    case $choice in
      addresses) page addresses ip -brief address ;;
      connections) nmtui ;;
      firewall) page firewall sudo ufw status verbose ;;
      tailscale) page tailscale tailscale status ;;
      tailscale-install) run_padded omarchy-install-service-tailscale; pause ;;
      tunnel) tunnel_setup; pause ;;
    esac
  done
}

# cloudflared is installed only for the owner who wants a tunnel.
tunnel_setup() {
  run_padded omarchy-pkg-add cloudflared || return
  printf '\n  Sign in to Cloudflare to create the tunnel.\n'
  run_padded cloudflared tunnel login
}

# Backups go through omarchy backup, pre-filling the last used restic
# repository so routine backups only need Enter.
backup() {
  local action=$1 state_dir repo_file last_repo="" repository

  state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
  repo_file="$state_dir/backup-repo"
  [[ -r $repo_file ]] && last_repo=$(<"$repo_file")

  clear
  printf '\n  %s\n' "$(crumb "Storage & backups" "Back up")"
  repository=$(gum input --padding="1 2" --prompt "Backup repository: " --placeholder "/mnt/nas/omarchy-backup" --value "$last_repo") || return
  [[ -n $repository ]] || return

  mkdir -p "$state_dir"
  printf '%s\n' "$repository" >"$repo_file"

  if run_padded --header "$(crumb "Storage & backups" "Back up")  $(pill_muted "$repository")" omarchy-backup "$action" "$repository" && [[ $action == "create" ]]; then
    omarchy-done mark server-backups
  fi
  pause
}

storage_menu() {
  local choice

  while :; do
    choice=$({
      row "" "Disks" "" disks
      row "" "Network mounts" "" mounts
      if grep -qx storage <<<"$(omarchy-server-setup-steps)"; then
        row "" "No network storage here" "marks storage as set up" storage-done
      fi
      if omarchy-cmd-present omarchy-backup; then
        row "" "Back up" "containers and their data" backup-create
        row "" "Verify a backup" "" backup-verify
        row "" "Restore a backup" "" backup-restore
      else
        row "" "Backups" "not available yet" backups-missing
      fi
    } | pick open --header "$(crumb_header "Storage & backups")") || return

    case $choice in
      disks) page disks lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS ;;
      mounts) page mounts findmnt -t nfs,nfs4,cifs,smb3,fuse.sshfs ;;
      storage-done) omarchy-done mark server-storage ;;
      backup-*) backup "${choice#backup-}" ;;
      backups-missing) clear; printf '\n  Backups are not part of Omarchy Server yet.\n'; pause ;;
    esac
  done
}

install_agent() {
  local agent=$1
  if in_popup; then
    open_tab "agent" "omarchy-default-agent --install $(printf '%q' "$agent") || { echo; read -rsn1 -p 'Press any key to close'; }"
  fi
  omarchy-default-agent --install "$agent" || { pause; return 1; }
}

add_agent_account() {
  local provider=$1 launch_args=()
  [[ $provider != "opencode" ]] && launch_args=(--provider "$provider")

  if in_popup; then
    local launch="omarchy-agent --inline"
    (( ${#launch_args[@]} )) && launch+=" $(printf '%q ' "${launch_args[@]}")"
    open_tab "agent" "omarchy-agent-account-add $(printf '%q' "$provider") && exec $launch || { echo; read -rsn1 -p 'Press any key to close'; }"
  fi
  omarchy-agent-account-add "$provider" && omarchy-agent --inline "${launch_args[@]}" || pause
}

agent_apikey_menu() {
  local provider
  provider=$({
    row "" "OpenRouter" "API key via OpenCode" openrouter
    row "" "Fireworks" "API key via OpenCode" fireworks
    row "" "DeepSeek" "API key via OpenCode" deepseek
    row "" "MiniMax" "API key via OpenCode" minimax
    row "" "Synthetic" "API key via OpenCode" synthetic
    row "" "Z.ai" "API key via OpenCode" zai
  } | pick choose --header "$(crumb_header "Agent" "API key")") || return 1

  add_agent_account "$provider"
}

agent_copy_hint() {
  local target
  target="$(id -un)@$(hostname -s 2>/dev/null || hostname)"
  clear
  printf '\n  %s\n\n' "$(crumb "Agent" "Copy from desktop")"
  printf '  Run this on your Omarchy desktop to transfer your\n'
  printf '  Claude, Codex, or Grok subscription over SSH:\n\n'
  printf '    %somarchy agent account copy %s%s\n\n' "$green" "$target" "$reset"
  printf '  %sCredentials travel over stdin only and never touch disk in transit.%s\n' "$dim" "$reset"
  pause
}

agent_other_menu() {
  local agent
  # The harnesses omarchy default agent takes, as its metadata lists them.
  agent=$(
    sed -n 's/^# omarchy:args=\[\(.*\)\]$/\1/p' "$(command -v omarchy-default-agent)" | tr '|' '\n' |
      while read -r name; do row "" "$name" "" "$name"; done | pick choose --header "$(crumb_header "Agent" "Other harness")"
  ) || return 1

  install_agent "$agent"
}

agent_menu() {
  local agent choice

  agent=$(omarchy-default-agent)
  if [[ -z $agent ]] || omarchy-cmd-missing "$agent"; then
    while :; do
      choice=$({
        row "" "Anthropic" "Claude Code" claude
        row "" "OpenAI" "Codex" codex
        row "" "OpenCode Go" "device-code auth, SSH-friendly" opencode
        row "" "API key" "OpenRouter, Fireworks, DeepSeek…" apikey
        row "" "Pi" "bring your own / multi-provider" pi
        row "" "Copy from desktop" "omarchy agent account copy" copy
        row "" "Other harness…" "all 25 harnesses" other
      } | pick choose --header "$(crumb_header "Agent")") || return

      case $choice in
        claude | codex | pi) install_agent "$choice"; return ;;
        opencode) add_agent_account opencode; return ;;
        apikey) agent_apikey_menu && return ;;
        copy) agent_copy_hint ;;
        other) agent_other_menu && return ;;
      esac
    done
  fi

  if in_popup; then
    open_tab "agent" "omarchy-agent --inline"
  fi
  omarchy-agent --inline
}

fleet_menu() {
  omarchy-fleet || pause
}

printf -v reload 'start:reload-sync:%q --rows-with-updates' "$0"
printf -v preview_cmd '%q --preview {2}' "$0"
while :; do
  choice=$(main_rows | pick open --header "$(crumb_header)" --bind "$reload" \
    --preview "$preview_cmd" \
    --preview-window="right:48%:border-left:wrap") || exit 0

  case $choice in
    setup) setup_menu ;;
    services) services_menu ;;
    network) network_menu ;;
    storage) storage_menu ;;
    agent) agent_menu ;;
    updates)
      if in_popup; then
        open_tab "update" "omarchy-update; echo; read -rsn1 -p 'Press any key to close'"
      else
        omarchy-update; pause
      fi
      ;;
    fleet) fleet_menu ;;
  esac
done
