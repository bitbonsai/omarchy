#!/bin/bash

# omarchy:summary=Open a shell or agent on another machine on Tailscale
# omarchy:args=[list|key|auth <host>|ssh <host>|agent <host>|update <host>]
# omarchy:examples=omarchy fleet | omarchy fleet list | omarchy fleet key | omarchy fleet auth nas | omarchy fleet ssh nas | omarchy fleet agent nas | omarchy fleet update nas

# Lists the other machines on this machine's tailnet in a type-to-filter list.
# Enter opens a shell, Ctrl+A starts the inline agent there, Ctrl+U runs an
# update. Inside tmux popup, each opens in its own tmux window tab. Fleet keeps
# a dedicated SSH key on this machine (~/.ssh/omarchy_fleet) that you authorize
# on each peer you want to reach.

set -euo pipefail

FLEET_KEY="${OMARCHY_FLEET_KEY:-$HOME/.ssh/omarchy_fleet}"

green=$'\e[32m' red=$'\e[31m' amber=$'\e[33m' dim=$'\e[2m' reset=$'\e[0m'

in_popup() {
  [[ -n ${OMARCHY_IN_POPUP:-} && -n ${TMUX:-} ]]
}

ensure_key() {
  if [[ ! -f $FLEET_KEY ]]; then
    mkdir -p "$(dirname "$FLEET_KEY")"
    chmod 700 "$(dirname "$FLEET_KEY")"
    ssh-keygen -q -t ed25519 -N '' -C "omarchy-fleet@$(hostname -s 2>/dev/null || hostname)" -f "$FLEET_KEY"
  fi
}

require_tailscale() {
  if ! command -v tailscale >/dev/null 2>&1; then
    echo "Fleet lists your other machines on Tailscale, which is not installed here." >&2
    return 1
  fi
  local status_json
  if ! status_json=$(tailscale status --json 2>/dev/null); then
    echo "Fleet lists your other machines on Tailscale, which is not connected here." >&2
    return 1
  fi
  if [[ $(jq -r '.BackendState // ""' <<<"$status_json") != "Running" ]]; then
    echo "Fleet lists your other machines on Tailscale, which is not connected here." >&2
    return 1
  fi
  printf '%s\n' "$status_json"
}

peers() {
  local status_json
  status_json=$(require_tailscale) || return 1

  jq -r '
    [
      .Peer // {} | .[]
      | select((.DNSName // "" | length) > 0 or (.HostName // "" | length) > 0)
      | select(((.Tags // []) | index("tag:mullvad-exit-node")) == null)
      | {
          host: (if (.DNSName // "") != "" then (.DNSName | split(".")[0]) else .HostName end),
          online: (.Online // false),
          ip: ((.TailscaleIPs // [])[0] // ""),
          os: (.OS // "")
        }
    ]
    | sort_by([(if .online then 0 else 1 end), (.host | ascii_downcase)])
    | .[]
    | [.host, (if .online then "online" else "offline" end), .ip, .os]
    | @tsv
  ' <<<"$status_json"
}

format_row() {
  local host=$1 state=$2 os=${3:-} pad=$(( 28 - ${#1} )) label=$state
  (( pad < 2 )) && pad=2
  [[ -n $os ]] && label="$state · $os"

  if [[ $state == "online" ]]; then
    printf '%s●%s %s%*s%s%s%s\t%s\t%s\n' "$green" "$reset" "$host" "$pad" "" "$green" "$label" "$reset" "$host" "$state"
  else
    printf '%s●%s %s%s%*s%s%s\t%s\t%s\n' "$red" "$reset" "$dim" "$host" "$pad" "" "$label" "$reset" "$host" "$state"
  fi
}

format_list() {
  local host state ip
  while IFS=$'\t' read -r host state ip _; do
    if [[ $state == "online" ]]; then
      printf '%s●%s %-20s %s%-8s%s %s%s%s\n' "$green" "$reset" "$host" "$green" "$state" "$reset" "$dim" "$ip" "$reset"
    else
      printf '%s●%s %-20s %s%-8s%s %s%s%s\n' "$red" "$reset" "$host" "$red" "$state" "$reset" "$dim" "$ip" "$reset"
    fi
  done
}

connect() {
  local mode=$1 host=$2 rc=0
  ensure_key

  if [[ $mode == "agent" ]]; then
    # A login shell, so a Server peer running Omarchy from its checkout finds it.
    ssh -t -i "$FLEET_KEY" "$host" "bash -lc 'omarchy agent --inline'" || rc=$?
  elif [[ $mode == "update" ]]; then
    ssh -t -i "$FLEET_KEY" "$host" "bash -lc 'omarchy update'" || rc=$?
  else
    ssh -i "$FLEET_KEY" "$host" || rc=$?
  fi

  if (( rc == 255 )); then
    echo "Could not connect to $host. If it refused the key, authorize this machine's Fleet key there: omarchy fleet auth $host" >&2
  fi
  return "$rc"
}

preview_peer() {
  local host=${1:-} state=${2:-}
  [[ -n $host ]] || return 0

  printf '%s%s%s\n\n' "$amber" "$host" "$reset"
  if [[ $state == "offline" ]]; then
    printf '  %s○ Offline%s\n' "$dim" "$reset"
    return 0
  fi

  if [[ ! -f $FLEET_KEY ]]; then
    printf '  %s● Online%s\n\n' "$green" "$reset"
    printf '  %sNo Fleet key yet.%s\n  Run: om fleet auth %s\n' "$dim" "$reset" "$host"
    return 0
  fi

  local out
  if out=$(ssh -o BatchMode=yes -o ConnectTimeout=2 -o StrictHostKeyChecking=accept-new -i "$FLEET_KEY" "$host" \
    "bash -lc 'om status 2>/dev/null || omarchy-server-status 2>/dev/null || { uname -sr; uptime -p; df -h / | tail -1; }'" 2>/dev/null); then
    printf '%s\n' "$out"
  else
    printf '  %s● Online%s\n\n' "$green" "$reset"
    printf '  %sFleet key not authorized on %s.%s\n' "$dim" "$host" "$reset"
    printf '  Run: om fleet auth %s\n' "$host"
  fi
}

pick_peer() {
  local peer_list choice key line host state preview_cmd

  peer_list=$(peers) || return 1
  if [[ -z $peer_list ]]; then
    echo "No other machines on Tailscale."
    return 0
  fi

  printf -v preview_cmd '%q --preview {2} {3}' "$0"
  choice=$(
    while IFS=$'\t' read -r host state _ os; do
      format_row "$host" "$state" "$os"
    done <<<"$peer_list" |
      fzf --ansi --layout=reverse --height=100% --padding="0,1" --info=hidden --no-separator \
        --delimiter=$'\t' --with-nth=1 --prompt="❯ " --ghost="Go…" --pointer="▌" --gutter=" " \
        --color="pointer:#e0af68,fg+:#e0af68,bg+:#24283b,hl:#e0af68,hl+:#e0af68,border:#3b3526,separator:#24283b,prompt:#e0af68,ghost:#565f89" \
        --preview "$preview_cmd" --preview-window="right:48%:border-left:wrap" \
        --footer="↵ shell     ctrl-a agent     ctrl-u update     esc back" \
        --expect=ctrl-a,ctrl-u
  ) || return 0

  key=$(head -1 <<<"$choice")
  line=$(tail -n +2 <<<"$choice")
  [[ -n $line ]] || return 0

  IFS=$'\t' read -r _ host state <<<"$line"
  [[ -n $host ]] || return 0

  if [[ $state == "offline" ]]; then
    echo "$host is offline." >&2
    return 1
  fi

  local mode="ssh" tab_name="$host"
  if [[ $key == "ctrl-a" ]]; then
    mode="agent"
    tab_name="$host:agent"
  elif [[ $key == "ctrl-u" ]]; then
    mode="update"
    tab_name="$host:update"
  fi

  if in_popup; then
    tmux new-window -n "$tab_name" "$(printf '%q %q %q' "$0" "$mode" "$host")"
    return 0
  fi

  connect "$mode" "$host"
}

cmd=${1:-}
case $cmd in
  --preview)
    preview_peer "${2:-}" "${3:-}"
    ;;
  "")
    pick_peer
    ;;
  list)
    peer_list=$(peers) || exit 1
    if [[ -z $peer_list ]]; then
      echo "No other machines on Tailscale."
    elif [[ -t 1 ]]; then
      format_list <<<"$peer_list"
    else
      cut -f1-3 <<<"$peer_list"
    fi
    ;;
  key)
    ensure_key
    cat "$FLEET_KEY.pub"
    ;;
  auth)
    host=${2:-}
    if [[ -z $host ]]; then
      echo "Usage: omarchy fleet auth <host>" >&2
      exit 1
    fi
    ensure_key
    ssh-copy-id -i "$FLEET_KEY.pub" "$host"
    ;;
  ssh | agent | update)
    host=${2:-}
    if [[ -z $host ]]; then
      echo "Usage: omarchy fleet $cmd <host>" >&2
      exit 1
    fi
    connect "$cmd" "$host"
    ;;
  *)
    echo "Usage: omarchy fleet [list|key|auth <host>|ssh <host>|agent <host>|update <host>]" >&2
    exit 1
    ;;
esac
